startup --host_jvm_args=-DBAZEL_TRACK_SOURCE_DIRECTORIES=1

common --enable_platform_specific_config
common --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1
common --repo_env=BAZEL_NO_APPLE_CPP_TOOLCHAIN=1
common --repo_env=BAZEL_DO_NOT_DETECT_SWIFT_TOOLCHAIN=1
common --incompatible_repo_env_ignores_action_env

build --use_top_level_targets_for_symlinks
build --verbose_failures
build --xcode_version_config=@apple_cross_toolchain//:host_xcodes
build --@build_bazel_rules_apple//apple:sdk_tool_files=@apple_cross_toolchain//:sdk_tool_files

# rules_apple's own actions (actool, plists, codesign) find the staged Apple
# tools through these. The C++ and Swift toolchains carry the same values
# themselves, so compile actions keep them under --config=remote_compile, where
# these are deliberately absent and the Apple tools are the ones in a local
# Xcode. Keep the values in sync with toolchain/BUILD.template.bzl and
# toolchain/swift_toolchain.bzl.
build:linux --action_env=DEVELOPER_DIR=external/+apple_cross_toolchain+apple_cross_toolchain/Xcode.app/Contents/Developer
build:linux --action_env=PATH=external/+apple_cross_toolchain+apple_cross_toolchain/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin:/bin:/usr/bin:/usr/local/bin
build:remote --action_env=DEVELOPER_DIR=external/+apple_cross_toolchain+apple_cross_toolchain/Xcode.app/Contents/Developer
build:remote --action_env=PATH=external/+apple_cross_toolchain+apple_cross_toolchain/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin:/bin:/usr/bin:/usr/local/bin

# The clean-room Apple tools (actool, ibtool, ...) are strict by default: their
# output is byte-identical to Xcode's, or the build fails. Each deviation from
# Xcode's output can be accepted on its own; --config=relaxed accepts them all.
# See docs/clean-room/README.md#deviations.
#
# Icon Composer documents: their layers are Xcode's, their flattened images
# (rasters) this actool's.
build:relax_actool_icon_composer --action_env=RULES_APPLECROSS_RELAX_ACTOOL_ICON_COMPOSER=1
# tvOS app icons' radiosity images, whose rounding may differ from Xcode's.
build:relax_actool_tvos_radiosity --action_env=RULES_APPLECROSS_RELAX_ACTOOL_TVOS_RADIOSITY=1
# Vector images (PDF, SVG): their bitmaps this actool's drawing, a PDF stored
# as it is (Xcode draws them with CoreGraphics and writes the PDF again).
build:relax_actool_vector --action_env=RULES_APPLECROSS_RELAX_ACTOOL_VECTOR=1
# Images stored as this actool chooses where Xcode's choice isn't established:
# atlases split next-fit, dmp2 streams near a margin or tied, bitmap keys in
# CoreFoundation's order for an identifier count whose growth isn't pinned.
build:relax_actool_storage --action_env=RULES_APPLECROSS_RELAX_ACTOOL_STORAGE=1
# Asset catalogs this actool can't reproduce, their images and data copied
# uncompiled, with no Assets.car.
build:relax_actool_uncompiled --action_env=RULES_APPLECROSS_RELAX_ACTOOL_UNCOMPILED=1
# DocC archives without Xcode's render template (an SDK archive packaged
# before it was kept), with swift.org's.
build:relax_docc --action_env=RULES_APPLECROSS_RELAX_DOCC=1
# Interface Builder files this ibtool can't reproduce, left uncompiled.
build:relax_ibtool --action_env=RULES_APPLECROSS_RELAX_IBTOOL=1
# Core Data models, whose VersionInfo.plist leaves out the entity version
# hashes and checksums (Core Data computes them itself) and with no .omo;
# generated classes with a fixed header line in place of the user and date.
build:relax_momc --action_env=RULES_APPLECROSS_RELAX_MOMC=1
# iOS PNGs this pngcrush can't reproduce (other than 8-bit RGB and RGBA),
# copied as they are rather than iPhone-optimized.
build:relax_pngcrush --action_env=RULES_APPLECROSS_RELAX_PNGCRUSH=1
# Metal shaders, compiled to an empty library (they fail at run time).
build:relax_metal --action_env=RULES_APPLECROSS_RELAX_METAL=1
# String Catalog entries not yet reproduced, written in their nearest form.
build:relax_xcstrings --action_env=RULES_APPLECROSS_RELAX_XCSTRINGS=1
# App Intents not yet reproduced, left out of the app's metadata.
build:relax_app_intents --action_env=RULES_APPLECROSS_RELAX_APP_INTENTS=1
# App Shortcuts Flexible Matching's trained assets, left out.
build:relax_app_intents_flexible_matching --action_env=RULES_APPLECROSS_RELAX_APP_INTENTS_FLEXIBLE_MATCHING=1
# An Xcode whose recorded library versions actool, coremlc and momc don't
# know, recorded with the nearest known Xcode's (27.0's before 27.2, 27.2's
# after; momc knows 27.2's only).
build:relax_xcode_version --action_env=RULES_APPLECROSS_RELAX_XCODE_VERSION=1
# Flags only Xcode's clang accepts (-fobjc-relative-method-lists and others),
# dropped off a Mac, where LLVM's clang compiles.
build:relax_clang_apple_flags --action_env=RULES_APPLECROSS_RELAX_APPLE_CLANG_FLAGS=1
# Another build of xcode_version's Xcode than the pinned one (27B48 for 27.2's
# 27B52), when the same Swift built its SDKs; the bundling tools still match
# the pinned build's output. Read when the toolchain repository is fetched.
build:relax_xcode_build --repo_env=RULES_APPLECROSS_RELAX_XCODE_BUILD=1
build:relaxed --config=relax_actool_icon_composer
build:relaxed --config=relax_actool_tvos_radiosity
build:relaxed --config=relax_actool_vector
build:relaxed --config=relax_actool_storage
build:relaxed --config=relax_actool_uncompiled
build:relaxed --config=relax_docc
build:relaxed --config=relax_ibtool
build:relaxed --config=relax_momc
build:relaxed --config=relax_pngcrush
build:relaxed --config=relax_metal
build:relaxed --config=relax_xcstrings
build:relaxed --config=relax_app_intents
build:relaxed --config=relax_app_intents_flexible_matching
build:relaxed --config=relax_xcode_version
build:relaxed --config=relax_clang_apple_flags
build:relaxed --config=relax_xcode_build
# Ported tools from before these configs read only this.
build:relaxed --action_env=RULES_APPLECROSS_RESOURCE_OUTPUT_MODE=relaxed

# BuildBuddy's cache without remote execution.
build:remote_cache --bes_results_url=https://app.buildbuddy.io/invocation/
build:remote_cache --bes_backend=grpcs://app.buildbuddy.io
common:remote_cache --remote_cache=grpcs://app.buildbuddy.io
common:remote_cache --remote_cache_compression

# Shared by the two remote modes below. Never select this config directly.
common:remote_base --config=remote_cache
build:remote_base --jobs=100
build:remote_base --@rules_python//python/config_settings:bootstrap_impl=script
build:remote_base --experimental_propagate_custom_flag=@rules_python//python/config_settings:bootstrap_impl
build:remote_base --strategy=SwiftCompile=remote,sandboxed,worker,local
common:remote_base --remote_executor=grpcs://app.buildbuddy.io

# Everything on the executors, including linking, bundling and signing.
common:remote --config=remote_base
build:remote --extra_execution_platforms=//platforms:linux_x86_64

# Compiling and archiving on the executors, everything downstream on this Mac
# with its real Xcode. Compile actions are identical to --config=remote, so both
# configs share the remote cache.
common:remote_compile --config=remote_base
build:remote_compile --extra_execution_platforms=//platforms:linux_x86_64,//platforms:macos_arm64_local
build:remote_compile --//toolchain:apple_bundling=macos
# Linking Apple products locally needs a macOS-executable C++ toolchain, which
# the global BAZEL_NO_APPLE_CPP_TOOLCHAIN above suppresses.
common:remote_compile --repo_env=BAZEL_NO_APPLE_CPP_TOOLCHAIN=0
# A remote outage must fail the build rather than compile on this Mac. Bazel
# already defaults to this; stated because the split depends on it.
build:remote_compile --noremote_local_fallback

common --remote_timeout=10m
