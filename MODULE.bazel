module(
    name = "rules_applecross",
    version = "0.0.3",
)

bazel_dep(name = "bazel_features", version = "1.50.0")
bazel_dep(name = "apple_support", version = "2.8.0")
single_version_override(
    module_name = "apple_support",
    version = "2.8.0",
)

apple_support_toolchain_env = use_repo_rule("@apple_support//toolchain:toolchain_env.bzl", "toolchain_env")

apple_support_toolchain_env(name = "apple_support_toolchain_env")

bazel_dep(name = "rules_apple", version = "4.5.3", repo_name = "build_bazel_rules_apple")
git_override(
    module_name = "rules_apple",
    commit = "74a3c3a2eb3d9c6432a32c158fc11e0cfaa4f881",
    patch_strip = 1,
    patches = [
        "//patches:rules_apple_no_exec_platform_constraint.patch",
        "//patches:rules_apple_bundletool_path.patch",
        "//patches:rules_apple_no_absolute_tool_paths.patch",
        "//patches:rules_apple_codesign_inputs_sdk_tools.patch",
        "//patches:rules_apple_python_stub_interpreter.patch",
    ],
    remote = "https://github.com/bazelbuild/rules_apple.git",
)

bazel_dep(name = "rules_swift", version = "4.0.0-rc4", repo_name = "build_bazel_rules_swift")
bazel_dep(name = "rules_cc", version = "0.2.20")
bazel_dep(name = "rules_python", version = "1.7.0")
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "llvm", version = "0.8.9")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "xctestrunner", version = "0.0.1")

bazel_dep(name = "fmt", version = "12.1.0", dev_dependency = True)
bazel_dep(name = "libpng", version = "1.6.54", dev_dependency = True)
bazel_dep(name = "sqlite3", version = "3.53.2", dev_dependency = True)
bazel_dep(name = "zlib", version = "1.3.2", dev_dependency = True)

git_override(
    module_name = "xctestrunner",
    commit = "9548d93f29a2a93315d7a0458622682c0f76e6fe",
    remote = "https://github.com/apple-cross-toolchain/xctestrunner-bash.git",
)

non_module_deps = use_extension("@build_bazel_rules_apple//apple:extensions.bzl", "non_module_deps", dev_dependency = True)

override_repo(
    non_module_deps,
    xctestrunner = "xctestrunner",
)

register_toolchains(
    "//testing:ios_test_toolchain",
    dev_dependency = True,
)

register_toolchains("@llvm//toolchain:linux_x86_64_to_linux_x86_64")

LLVM_PREBUILT_VERSION = "22.1.7"

llvm_toolchain_minimal = use_extension("@llvm//extensions:llvm_toolchain_minimal.bzl", "llvm_toolchain_minimal")
llvm_toolchain_minimal.release(
    llvm_version = LLVM_PREBUILT_VERSION,
)
use_repo(
    llvm_toolchain_minimal,
    "llvm-toolchain-minimal-%s-darwin-amd64" % LLVM_PREBUILT_VERSION,
    "llvm-toolchain-minimal-%s-darwin-arm64" % LLVM_PREBUILT_VERSION,
    "llvm-toolchain-minimal-%s-linux-arm64" % LLVM_PREBUILT_VERSION,
    "llvm-toolchain-minimal-%s-windows-amd64" % LLVM_PREBUILT_VERSION,
    "llvm-toolchain-minimal-%s-windows-arm64" % LLVM_PREBUILT_VERSION,
    llvm_prebuilt = "llvm-toolchain-minimal-%s-linux-amd64" % LLVM_PREBUILT_VERSION,
)

applecross_swift = use_extension("@build_bazel_rules_swift//swift:extensions.bzl", "swift")
# Must match the Swift that built the Apple SDKs, which is the Swift of the
# Xcode one release behind the SDKs' own: Xcode 26.6 ships the 26.5 SDKs, and
# those were built by Swift 6.3.2.
applecross_swift.toolchain(
    name = "applecross_swift",
    platform_sha256 = {
        "ubuntu24.04": "827b2e935b52425068729d277148f286b37886231299d71f9136bcffd7084339",
    },
    swift_version = "6.3.2",
)
use_repo(
    applecross_swift,
    "applecross_swift_ubuntu24.04",
)

apple_cross_toolchain = use_extension(
    "//toolchain:extensions.bzl",
    "apple_cross_toolchain",
)
apple_cross_toolchain.configure(
    name = "apple_cross_toolchain",
    apple_sdk_archive_type = "tar.zst",
    apple_sdk_path = "apple-sdks.tar.zst",
    # macOS hosts read their own Xcode; other hosts need the archive above.
    local_xcode = True,
    swift_tools = "@applecross_swift_ubuntu24.04//:tools",
)
use_repo(apple_cross_toolchain, "apple_cross_toolchain")

register_toolchains("@apple_cross_toolchain//:all")
