program(1.0)
[buildInfo = dict<tensor<string, []>, tensor<string, []>>({{"coremlc-component-MIL", "3600.16.1"}, {"coremlc-version", "3600.25.1"}, {"coremltools-component-milinternal", ""}, {"coremltools-version", "9.0"}})]
{
    func main<ios16>(tensor<fp16, [1, 3]> x, tensor<fp32, [1, 3]> y) {
            tensor<fp16, [1, 3]> relu_0 = relu(x = x)[name = tensor<string, []>("relu_0")];
            tensor<string, []> y_to_fp16_dtype_0 = const()[name = tensor<string, []>("y_to_fp16_dtype_0"), val = tensor<string, []>("fp16")];
            tensor<fp16, [1, 3]> y_to_fp16 = cast(dtype = y_to_fp16_dtype_0, x = y)[name = tensor<string, []>("cast_1")];
            tensor<fp16, [1, 3]> relu_1_cast_fp16 = relu(x = y_to_fp16)[name = tensor<string, []>("relu_1_cast_fp16")];
            tensor<string, []> relu_1_cast_fp16_to_fp32_dtype_0 = const()[name = tensor<string, []>("relu_1_cast_fp16_to_fp32_dtype_0"), val = tensor<string, []>("fp32")];
            tensor<fp32, [1, 3]> relu_1 = cast(dtype = relu_1_cast_fp16_to_fp32_dtype_0, x = relu_1_cast_fp16)[name = tensor<string, []>("cast_0")];
        } -> (relu_0, relu_1);
}