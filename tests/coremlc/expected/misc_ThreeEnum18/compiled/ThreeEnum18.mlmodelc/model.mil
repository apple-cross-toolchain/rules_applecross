program(1.3)
[buildInfo = dict<string, string>({{"coremlc-component-MIL", "3600.16.1"}, {"coremlc-version", "3600.25.1"}, {"coremltools-component-milinternal", ""}, {"coremltools-version", "9.0"}})]
{
    func main<ios18>(tensor<fp32, [1, ?]> a, tensor<fp32, [?, 2]> b, tensor<fp32, [1, 3, ?, ?]> c) [FlexibleShapeInformation = tuple<tuple<string, dict<string, tensor<int32, [?]>>>, tuple<string, dict<string, dict<string, tensor<int32, [?]>>>>>((("DefaultShapes", {{"a", [1, 4]}, {"b", [3, 2]}, {"c", [1, 3, 4, 4]}}), ("EnumeratedShapes", {{"55d485bf", {{"a", [1, 5]}, {"b", [6, 2]}, {"c", [1, 3, 2, 6]}}}, {"72e7c4b0", {{"a", [1, 2]}, {"b", [5, 2]}, {"c", [1, 3, 8, 8]}}}, {"cc85776f", {{"a", [1, 4]}, {"b", [3, 2]}, {"c", [1, 3, 4, 4]}}}})))] {
            tensor<fp32, [1, ?]> relu_0 = relu(x = a)[name = string("relu_0")];
            tensor<fp32, [?, 2]> relu_1 = relu(x = b)[name = string("relu_1")];
            tensor<int32, [2]> reduce_mean_0_axes_0 = const()[name = string("reduce_mean_0_axes_0"), val = tensor<int32, [2]>([2, 3])];
            bool reduce_mean_0_keep_dims_0 = const()[name = string("reduce_mean_0_keep_dims_0"), val = bool(false)];
            tensor<fp32, [1, 3]> reduce_mean_0 = reduce_mean(axes = reduce_mean_0_axes_0, keep_dims = reduce_mean_0_keep_dims_0, x = c)[name = string("reduce_mean_0")];
        } -> (relu_0, relu_1, reduce_mean_0);
