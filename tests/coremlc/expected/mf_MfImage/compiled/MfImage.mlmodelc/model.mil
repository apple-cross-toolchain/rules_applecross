program(1.3)
[buildInfo = dict<string, string>({{"coremlc-component-MIL", "3600.16.1"}, {"coremlc-version", "3600.25.1"}})]
{
    func pool<ios18>(tensor<fp32, [1, 3, 8, 8]> img) {
            tensor<int32, [2]> reduce_mean_0_axes_0 = const()[name = string("reduce_mean_0_axes_0"), val = tensor<int32, [2]>([2, 3])];
            bool reduce_mean_0_keep_dims_0 = const()[name = string("reduce_mean_0_keep_dims_0"), val = bool(false)];
            tensor<fp32, [1, 3]> reduce_mean_0 = reduce_mean(axes = reduce_mean_0_axes_0, keep_dims = reduce_mean_0_keep_dims_0, x = img)[name = string("reduce_mean_0")];
        } -> (reduce_mean_0);
    func relu<ios18>(tensor<fp32, [1, 3]> x) {
            tensor<fp32, [1, 3]> relu_0 = relu(x = x)[name = string("relu_0")];
        } -> (relu_0);
}