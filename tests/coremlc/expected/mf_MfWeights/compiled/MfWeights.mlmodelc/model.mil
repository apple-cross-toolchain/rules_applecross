program(1.3)
[buildInfo = dict<string, string>({{"coremlc-component-MIL", "3600.16.1"}, {"coremlc-version", "3600.25.1"}})]
{
    func half<ios18>(tensor<fp32, [1, 8]> x) {
            tensor<fp32, [4, 8]> linear_0_weight_0 = const()[name = string("linear_0_weight_0"), val = tensor<fp32, [4, 8]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(64)))];
            tensor<fp32, [4]> linear_0_bias_0 = const()[name = string("linear_0_bias_0"), val = tensor<fp32, [4]>([0x0p+0, 0x0p+0, 0x0p+0, 0x0p+0])];
            tensor<fp32, [1, 4]> linear_0 = linear(bias = linear_0_bias_0, weight = linear_0_weight_0, x = x)[name = string("linear_0")];
        } -> (linear_0);
    func quarter<ios18>(tensor<fp32, [1, 8]> x) {
            tensor<fp32, [4, 8]> linear_0_weight_0 = const()[name = string("linear_0_weight_0"), val = tensor<fp32, [4, 8]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(256)))];
            tensor<fp32, [4]> linear_0_bias_0 = const()[name = string("linear_0_bias_0"), val = tensor<fp32, [4]>([0x0p+0, 0x0p+0, 0x0p+0, 0x0p+0])];
            tensor<fp32, [1, 4]> linear_0 = linear(bias = linear_0_bias_0, weight = linear_0_weight_0, x = x)[name = string("linear_0")];
        } -> (linear_0);
}