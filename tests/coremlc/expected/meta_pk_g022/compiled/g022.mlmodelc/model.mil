program(1.3)
[buildInfo = dict<string, string>({{"coremlc-component-MIL", "3600.16.1"}, {"coremlc-version", "3600.25.1"}, {"coremltools-component-milinternal", ""}, {"coremltools-version", "9.0"}})]
{
    func main<ios18>(tensor<fp32, [1, 3, 8, 8]> img) {
            string img_to_fp16_dtype_0 = const()[name = string("img_to_fp16_dtype_0"), val = string("fp16")];
            tensor<fp16, [1, 3, 8, 8]> img_to_fp16 = cast(dtype = img_to_fp16_dtype_0, x = img)[name = string("cast_1")];
            tensor<fp16, [1, 3, 8, 8]> feat_cast_fp16 = relu(x = img_to_fp16)[name = string("feat_cast_fp16")];
            string feat_cast_fp16_to_fp32_dtype_0 = const()[name = string("feat_cast_fp16_to_fp32_dtype_0"), val = string("fp32")];
            tensor<fp32, [1, 3, 8, 8]> feat = cast(dtype = feat_cast_fp16_to_fp32_dtype_0, x = feat_cast_fp16)[name = string("cast_0")];
        } -> (feat);
}