program(1.3)
[buildInfo = dict<string, string>({{"coremlc-component-MIL", "3600.16.1"}, {"coremlc-version", "3600.25.1"}, {"coremltools-component-milinternal", ""}, {"coremltools-version", "9.0"}})]
{
    func main<ios18>(tensor<fp32, [1, 1, 4, 4]> x) {
            tensor<fp32, [1, 1, 4, 4]> silu_0 = silu(x = x)[name = string("silu_0")];
            tensor<fp32, [1, 1, 4, 4]> o_silu_0 = identity(x = silu_0)[name = string("o_silu_0")];
            int32 range_1d_0_start_0 = const()[name = string("range_1d_0_start_0"), val = int32(0)];
            int32 range_1d_0_end_0 = const()[name = string("range_1d_0_end_0"), val = int32(4)];
            int32 range_1d_0_step_0 = const()[name = string("range_1d_0_step_0"), val = int32(1)];
            tensor<int32, [4]> range_1d_0 = range_1d(end = range_1d_0_end_0, start = range_1d_0_start_0, step = range_1d_0_step_0)[name = string("range_1d_0")];
            string cast_0_dtype_0 = const()[name = string("cast_0_dtype_0"), val = string("fp32")];
            tensor<fp32, [4]> cast_0 = cast(dtype = cast_0_dtype_0, x = range_1d_0)[name = string("cast_0")];
            tensor<fp32, [4]> o_range_1d_1 = identity(x = cast_0)[name = string("o_range_1d_1")];
            bool matmul_0_transpose_x_0 = const()[name = string("matmul_0_transpose_x_0"), val = bool(false)];
            bool matmul_0_transpose_y_0 = const()[name = string("matmul_0_transpose_y_0"), val = bool(false)];
            tensor<fp32, [1, 1, 4, 4]> matmul_0 = matmul(transpose_x = matmul_0_transpose_x_0, transpose_y = matmul_0_transpose_y_0, x = x, y = x)[name = string("matmul_0")];
            tensor<fp32, [1, 1, 4, 4]> o_matmul_2 = identity(x = matmul_0)[name = string("o_matmul_2")];
            int32 cumsum_0_axis_0 = const()[name = string("cumsum_0_axis_0"), val = int32(3)];
            bool cumsum_0_exclusive_0 = const()[name = string("cumsum_0_exclusive_0"), val = bool(false)];
            bool cumsum_0_reverse_0 = const()[name = string("cumsum_0_reverse_0"), val = bool(false)];
            tensor<fp32, [1, 1, 4, 4]> cumsum_0 = cumsum(axis = cumsum_0_axis_0, exclusive = cumsum_0_exclusive_0, reverse = cumsum_0_reverse_0, x = x)[name = string("cumsum_0")];
            tensor<fp32, [1, 1, 4, 4]> o_cumsum_3 = identity(x = cumsum_0)[name = string("o_cumsum_3")];
            tensor<int32, [2]> reshape_0_shape_0 = const()[name = string("reshape_0_shape_0"), val = tensor<int32, [2]>([2, 8])];
            tensor<fp32, [2, 8]> reshape_0 = reshape(shape = reshape_0_shape_0, x = x)[name = string("reshape_0")];
            tensor<fp32, [3, 8]> linear_0_weight_0 = const()[name = string("linear_0_weight_0"), val = tensor<fp32, [3, 8]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(64)))];
            tensor<fp32, [3]> linear_0_bias_0 = const()[name = string("linear_0_bias_0"), val = tensor<fp32, [3]>([0x0p+0, 0x0p+0, 0x0p+0])];
            tensor<fp32, [2, 3]> linear_0 = linear(bias = linear_0_bias_0, weight = linear_0_weight_0, x = reshape_0)[name = string("linear_0")];
            tensor<fp32, [2, 3]> o_linear_4 = identity(x = linear_0)[name = string("o_linear_4")];
            tensor<int32, [1]> scatter_0_indices_0 = const()[name = string("scatter_0_indices_0"), val = tensor<int32, [1]>([0])];
            int32 scatter_0_axis_0 = const()[name = string("scatter_0_axis_0"), val = int32(0)];
            string scatter_0_mode_0 = const()[name = string("scatter_0_mode_0"), val = string("add")];
            bool scatter_0_validate_indices_0 = const()[name = string("scatter_0_validate_indices_0"), val = bool(false)];
            tensor<fp32, [1, 1, 4, 4]> scatter_0 = scatter(axis = scatter_0_axis_0, data = x, indices = scatter_0_indices_0, mode = scatter_0_mode_0, updates = x, validate_indices = scatter_0_validate_indices_0)[name = string("scatter_0")];
            tensor<fp32, [1, 1, 4, 4]> o_scatter_5 = identity(x = scatter_0)[name = string("o_scatter_5")];
        } -> (o_silu_0, o_range_1d_1, o_matmul_2, o_cumsum_3, o_linear_4, o_scatter_5);
}