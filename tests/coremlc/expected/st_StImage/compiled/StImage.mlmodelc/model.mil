    func main<ios18>(tensor<fp32, [1, 3, 4, 4]> img, state<tensor<fp16, [1, 3, 4, 4]>> s) {
            tensor<fp16, [1, 3, 4, 4]> read_state_0 = read_state(input = s)[name = string("read_state_0")];
