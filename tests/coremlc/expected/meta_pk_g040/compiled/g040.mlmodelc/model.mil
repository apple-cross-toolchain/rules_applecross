program(1.3)
[buildInfo = dict<string, string>({{"coremlc-component-MIL", "3600.16.1"}, {"coremlc-version", "3600.25.1"}, {"coremltools-component-milinternal", ""}, {"coremltools-version", "9.0"}})]
{
    func main<ios18>(tensor<fp32, [1, 3]> x) {
            int32 probs_axis_0 = const()[name = string("probs_axis_0"), val = int32(-1)];
            string x_to_fp16_dtype_0 = const()[name = string("x_to_fp16_dtype_0"), val = string("fp16")];
            tensor<fp16, [1, 3]> x_to_fp16 = cast(dtype = x_to_fp16_dtype_0, x = x)[name = string("cast_1")];
            tensor<fp16, [1, 3]> probs_cast_fp16 = softmax(axis = probs_axis_0, x = x_to_fp16)[name = string("probs_cast_fp16")];
            string probs_cast_fp16_to_fp32_dtype_0 = const()[name = string("probs_cast_fp16_to_fp32_dtype_0"), val = string("fp32")];
            tensor<fp32, [1, 3]> probs = cast(dtype = probs_cast_fp16_to_fp32_dtype_0, x = probs_cast_fp16)[name = string("cast_0")];
        } -> (probs);
}