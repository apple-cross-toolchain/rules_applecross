            tensor<fp16, [1, 1, 4, 4]> sign_0_cast_fp16 = sign(x = x_to_fp16)[name = tensor<string, []>("sign_0_cast_fp16")];
            tensor<string, []> o_sign_4_cast_fp16_to_fp32_dtype_0 = const()[name = tensor<string, []>("o_sign_4_cast_fp16_to_fp32_dtype_0"), val = tensor<string, []>("fp32")];
            tensor<int32, [1]> reduce_max_0_axes_0 = const()[name = tensor<string, []>("reduce_max_0_axes_0"), val = tensor<int32, [1]>([3])];
