            tensor<string, []> o_reduce_max_5_cast_fp16_to_fp32_dtype_0 = const()[name = tensor<string, []>("o_reduce_max_5_cast_fp16_to_fp32_dtype_0"), val = tensor<string, []>("fp32")];
