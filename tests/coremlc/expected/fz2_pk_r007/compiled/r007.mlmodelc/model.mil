            tensor<fp32, [2, 1, 1, 4, 4]> o_stack_2 = cast(dtype = o_stack_2_cast_fp16_to_fp32_dtype_0, x = stack_0_cast_fp16)[name = tensor<string, []>("cast_4")];
            tensor<fp32, [1, 1, 4, 4]> o_inverse_0 = cast(dtype = o_inverse_0_cast_fp16_to_fp32_dtype_0, x = inverse_0_cast_fp16)[name = tensor<string, []>("cast_5")];
        } -> (o_inverse_0, o_shape_1, o_stack_2, o_atan_3, o_sign_4, o_reduce_max_5);
