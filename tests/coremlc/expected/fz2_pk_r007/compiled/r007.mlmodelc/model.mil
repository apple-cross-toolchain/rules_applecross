[buildInfo = dict<tensor<string, []>, tensor<string, []>>({{"coremlc-component-MIL", "3600.16.1"}, {"coremlc-version", "3600.25.1"}, {"coremltools-component-milinternal", ""}, {"coremltools-version", "9.0"}})]
{
    func main<ios17>(tensor<fp32, [1, 1, 4, 4]> x) {
            tensor<fp32, []> inverse_0_epsilon_0 = const()[name = tensor<string, []>("inverse_0_epsilon_0"), val = tensor<fp32, []>(0x1.a36e2ep-14)];
            tensor<string, []> x_to_fp16_dtype_0 = const()[name = tensor<string, []>("x_to_fp16_dtype_0"), val = tensor<string, []>("fp16")];
            tensor<fp16, [1, 1, 4, 4]> x_to_fp16 = cast(dtype = x_to_fp16_dtype_0, x = x)[name = tensor<string, []>("cast_6")];
            tensor<fp16, [1, 1, 4, 4]> inverse_0_cast_fp16 = inverse(epsilon = inverse_0_epsilon_0, x = x_to_fp16)[name = tensor<string, []>("inverse_0_cast_fp16")];
            tensor<string, []> o_inverse_0_cast_fp16_to_fp32_dtype_0 = const()[name = tensor<string, []>("o_inverse_0_cast_fp16_to_fp32_dtype_0"), val = tensor<string, []>("fp32")];
            tensor<fp32, [4]> o_shape_1 = const()[name = tensor<string, []>("o_shape_1"), val = tensor<fp32, [4]>([0x1p+0, 0x1p+0, 0x1p+2, 0x1p+2])];
            tensor<int32, []> stack_0_axis_0 = const()[name = tensor<string, []>("stack_0_axis_0"), val = tensor<int32, []>(0)];
            tensor<fp16, [2, 1, 1, 4, 4]> stack_0_cast_fp16 = stack(axis = stack_0_axis_0, values = (x_to_fp16, x_to_fp16))[name = tensor<string, []>("stack_0_cast_fp16")];
            tensor<string, []> o_stack_2_cast_fp16_to_fp32_dtype_0 = const()[name = tensor<string, []>("o_stack_2_cast_fp16_to_fp32_dtype_0"), val = tensor<string, []>("fp32")];
            tensor<fp16, [1, 1, 4, 4]> atan_0_cast_fp16 = atan(x = x_to_fp16)[name = tensor<string, []>("atan_0_cast_fp16")];
