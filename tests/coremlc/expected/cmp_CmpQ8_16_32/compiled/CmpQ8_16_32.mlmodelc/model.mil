            tensor<fp32, [8, 16]> linear_1_weight_0_quantized = constexpr_affine_dequantize()[axis = tensor<int32, []>(0), name = tensor<string, []>("linear_1_weight_0_quantized"), quantized_data = tensor<int8, [8, 16]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(1024))), scale = tensor<fp32, [8]>([0x1.31b204p-6, 0x1.4a27acp-6, 0x1.0377ccp-6, 0x1.88f9f8p-6, 0x1.ac7c9ap-7, 0x1.c18e2ap-7, 0x1.af212ep-7, 0x1.2b5ffcp-6]), zero_point = tensor<int8, [8]>([0, 0, 0, 0, 0, 0, 0, 0])];
            tensor<fp32, [8]> linear_1_bias_0 = const()[name = tensor<string, []>("linear_1_bias_0"), val = tensor<fp32, [8]>([0x0p+0, 0x0p+0, 0x0p+0, 0x0p+0, 0x0p+0, 0x0p+0, 0x0p+0, 0x0p+0])];
