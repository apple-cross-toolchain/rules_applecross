program(1.3)
[buildInfo = dict<string, string>({{"coremlc-component-MIL", "3600.16.1"}, {"coremlc-version", "3600.25.1"}})]
{
    func main<ios18>(tensor<fp32, [1, 32]> x) {
            string x_to_fp16_dtype_0 = const()[name = string("x_to_fp16_dtype_0"), val = string("fp16")];
            tensor<fp16, [16, 32]> linear_0_weight_0_to_fp16_quantized = constexpr_blockwise_shift_scale(data = tensor<uint8, [16, 32]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(64))), offset = tensor<uint8, [16, 1]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(768))), scale = tensor<fp16, [16, 1]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(640))))[name = string("linear_0_weight_0_to_fp16_quantized")];
            tensor<fp16, [16]> linear_0_bias_0_to_fp16 = const()[name = string("linear_0_bias_0_to_fp16"), val = tensor<fp16, [16]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(896)))];
            tensor<fp16, [1, 32]> x_to_fp16 = cast(dtype = x_to_fp16_dtype_0, x = x)[name = string("cast_1")];
            tensor<fp16, [1, 16]> linear_0_cast_fp16 = linear(bias = linear_0_bias_0_to_fp16, weight = linear_0_weight_0_to_fp16_quantized, x = x_to_fp16)[name = string("linear_0_cast_fp16")];
            tensor<fp16, [1, 16]> relu_0_cast_fp16 = relu(x = linear_0_cast_fp16)[name = string("relu_0_cast_fp16")];
            tensor<fp16, [8, 16]> linear_1_weight_0_to_fp16_quantized = constexpr_blockwise_shift_scale(data = tensor<uint8, [8, 16]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(1024))), offset = tensor<uint8, [8, 1]>([[155], [169], [122], [186], [204], [147], [108], [153]]), scale = tensor<fp16, [8, 1]>([[0x1.f38p-7], [0x1.ef8p-7], [0x1.edcp-7], [0x1.0c8p-6], [0x1.0bp-7], [0x1.85p-7], [0x1.748p-7], [0x1.f18p-7]]))[name = string("linear_1_weight_0_to_fp16_quantized")];
            tensor<fp16, [8]> linear_1_bias_0_to_fp16 = const()[name = string("linear_1_bias_0_to_fp16"), val = tensor<fp16, [8]>([0x0p+0, 0x0p+0, 0x0p+0, 0x0p+0, 0x0p+0, 0x0p+0, 0x0p+0, 0x0p+0])];
            tensor<fp16, [1, 8]> linear_1_cast_fp16 = linear(bias = linear_1_bias_0_to_fp16, weight = linear_1_weight_0_to_fp16_quantized, x = relu_0_cast_fp16)[name = string("linear_1_cast_fp16")];
            string linear_1_cast_fp16_to_fp32_dtype_0 = const()[name = string("linear_1_cast_fp16_to_fp32_dtype_0"), val = string("fp32")];
            tensor<fp32, [1, 8]> linear_1 = cast(dtype = linear_1_cast_fp16_to_fp32_dtype_0, x = linear_1_cast_fp16)[name = string("cast_0")];
        } -> (linear_1);
}