program(1.3)
[buildInfo = dict<string, string>({{"coremlc-component-MIL", "3600.16.1"}, {"coremlc-version", "3600.25.1"}})]
{
    func main<ios18>(tensor<fp32, [1, 4, 6, 6]> x) {
            tensor<fp32, [8, 4, 3, 3]> conv_0_weight_0_quantized = constexpr_blockwise_shift_scale(data = tensor<int4, [8, 4, 3, 3]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(64))), offset = tensor<int4, [1, 1, 1, 1]>([[[[0]]]]), scale = tensor<fp32, [1, 1, 1, 1]>([[[[0x1.6b4666p-2]]]]))[name = string("conv_0_weight_0_quantized")];
            tensor<fp32, [8]> conv_0_bias_0 = const()[name = string("conv_0_bias_0"), val = tensor<fp32, [8]>([-0x1.1dd0fap+0, 0x1.4b7a38p-4, -0x1.7e1d2p-3, -0x1.d18192p-5, 0x1.f82712p-2, -0x1.5c81d8p-1, -0x1.5a2516p-4, -0x1.307fa2p-2])];
            tensor<int32, [2]> conv_0_strides_0 = const()[name = string("conv_0_strides_0"), val = tensor<int32, [2]>([1, 1])];
            string conv_0_pad_type_0 = const()[name = string("conv_0_pad_type_0"), val = string("valid")];
            tensor<int32, [4]> conv_0_pad_0 = const()[name = string("conv_0_pad_0"), val = tensor<int32, [4]>([0, 0, 0, 0])];
            tensor<int32, [2]> conv_0_dilations_0 = const()[name = string("conv_0_dilations_0"), val = tensor<int32, [2]>([1, 1])];
            int32 conv_0_groups_0 = const()[name = string("conv_0_groups_0"), val = int32(1)];
            tensor<fp32, [1, 8, 4, 4]> conv_0 = conv(bias = conv_0_bias_0, dilations = conv_0_dilations_0, groups = conv_0_groups_0, pad = conv_0_pad_0, pad_type = conv_0_pad_type_0, strides = conv_0_strides_0, weight = conv_0_weight_0_quantized, x = x)[name = string("conv_0")];
            tensor<fp32, [1, 8, 4, 4]> relu_0 = relu(x = conv_0)[name = string("relu_0")];
            tensor<int32, [2]> reshape_0_shape_0 = const()[name = string("reshape_0_shape_0"), val = tensor<int32, [2]>([1, 128])];
            tensor<fp32, [1, 128]> reshape_0 = reshape(shape = reshape_0_shape_0, x = relu_0)[name = string("reshape_0")];
            tensor<fp32, [16, 128]> linear_0_weight_0_quantized = constexpr_blockwise_shift_scale(data = tensor<int4, [16, 128]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(320))), offset = tensor<int4, [1, 1]>([[-1]]), scale = tensor<fp32, [1, 1]>([[0x1.e58284p-2]]))[name = string("linear_0_weight_0_quantized")];
            tensor<fp32, [16]> linear_0_bias_0 = const()[name = string("linear_0_bias_0"), val = tensor<fp32, [16]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(1408)))];
            tensor<fp32, [1, 16]> linear_0 = linear(bias = linear_0_bias_0, weight = linear_0_weight_0_quantized, x = reshape_0)[name = string("linear_0")];
            tensor<fp32, [1, 16]> relu_1 = relu(x = linear_0)[name = string("relu_1")];
            tensor<fp32, [8, 16]> linear_1_weight_0_quantized = constexpr_blockwise_shift_scale(data = tensor<int4, [8, 16]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(1536))), offset = tensor<int4, [1, 1]>([[-2]]), scale = tensor<fp32, [1, 1]>([[0x1.af9d6ap-2]]))[name = string("linear_1_weight_0_quantized")];
            tensor<fp32, [8]> linear_1_bias_0 = const()[name = string("linear_1_bias_0"), val = tensor<fp32, [8]>([0x0p+0, 0x0p+0, 0x0p+0, 0x0p+0, 0x0p+0, 0x0p+0, 0x0p+0, 0x0p+0])];
            tensor<fp32, [1, 8]> linear_1 = linear(bias = linear_1_bias_0, weight = linear_1_weight_0_quantized, x = relu_1)[name = string("linear_1")];
        } -> (linear_1);
}