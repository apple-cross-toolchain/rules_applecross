program(1.3)
[buildInfo = dict<string, string>({{"coremlc-component-MIL", "3600.16.1"}, {"coremlc-version", "3600.25.1"}, {"coremltools-component-milinternal", ""}, {"coremltools-version", "9.0"}})]
{
    func main<ios18>(tensor<fp32, [4]> x) {
            fp32 clip_0_alpha_0 = const()[name = string("clip_0_alpha_0"), val = fp32(-inf)];
            fp32 clip_0_beta_0 = const()[name = string("clip_0_beta_0"), val = fp32(0x1.8p+1)];
