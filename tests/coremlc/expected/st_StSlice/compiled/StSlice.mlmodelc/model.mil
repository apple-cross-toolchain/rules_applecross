program(1.3)
[buildInfo = dict<string, string>({{"coremlc-component-MIL", "3600.16.1"}, {"coremlc-version", "3600.25.1"}, {"coremltools-component-milinternal", ""}, {"coremltools-version", "9.0"}})]
{
    func main<ios18>(state<tensor<fp16, [4, 4]>> cache, tensor<fp16, [1, 4]> x) {
            tensor<fp16, [4, 4]> read_state_0 = read_state(input = cache)[name = string("read_state_0")];
            tensor<int32, [2]> slice_update_0_begin_0 = const()[name = string("slice_update_0_begin_0"), val = tensor<int32, [2]>([0, 0])];
