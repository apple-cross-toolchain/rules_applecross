// Our own Metal Shading Language subset for clang 15, written from the MSL
// specification and from the AIR Xcode emits for our probe shaders.
#pragma once
// The driver reads [[attributes]] (rewritten to __MSL_ATTR) and stage keywords
// from an AST pass with __MSL_AST defined; codegen sees neither.
#ifdef __MSL_AST
#define __MSL_ATTR(x) __attribute__((annotate(x)))
#else
#define __MSL_ATTR(x)
#endif
#define kernel static __MSL_ATTR("msl.stage:kernel") __attribute__((always_inline))
#define vertex static __MSL_ATTR("msl.stage:vertex") __attribute__((always_inline))
#define fragment static __MSL_ATTR("msl.stage:fragment") __attribute__((always_inline))
#define device __attribute__((address_space(1)))
#define constant __attribute__((address_space(2)))
#define threadgroup __attribute__((address_space(3)))
#define thread
#define __AIR(name) __asm__(name)

typedef unsigned char uchar;
typedef unsigned short ushort;
typedef unsigned int uint;
typedef unsigned long ulong;
typedef _Float16 half;
#define __MSL_VEC(T) \
  typedef T T##2 __attribute__((ext_vector_type(2))); \
  typedef T T##3 __attribute__((ext_vector_type(3))); \
  typedef T T##4 __attribute__((ext_vector_type(4)));
__MSL_VEC(char) __MSL_VEC(uchar) __MSL_VEC(short) __MSL_VEC(ushort) __MSL_VEC(int) __MSL_VEC(uint)
__MSL_VEC(long) __MSL_VEC(ulong) __MSL_VEC(half) __MSL_VEC(float)

namespace metal {
template <class T, int N> using __vector = T __attribute__((ext_vector_type(N)));
template <class T> struct __elem { typedef T type; static constexpr int n = 1; };
#define __MSL_ELEM(T) \
  template <> struct __elem<T##2> { typedef T type; static constexpr int n = 2; }; \
  template <> struct __elem<T##3> { typedef T type; static constexpr int n = 3; }; \
  template <> struct __elem<T##4> { typedef T type; static constexpr int n = 4; };
__MSL_ELEM(char) __MSL_ELEM(uchar) __MSL_ELEM(short) __MSL_ELEM(ushort) __MSL_ELEM(int) __MSL_ELEM(uint)
__MSL_ELEM(long) __MSL_ELEM(ulong) __MSL_ELEM(half) __MSL_ELEM(float)

// Vector constructors: T4(a, b, ...) takes scalars and vectors in order;
// T4(s) splats a scalar; T4(v) converts a vector of the same width.
template <class V, class E = typename __elem<V>::type, int N = __elem<V>::n>
struct __vbuild {
  V v; int i = 0;
  template <class A> __attribute__((always_inline)) void put(A a) {
    if constexpr (__elem<A>::n == 1) v[i++] = E(a);
    else for (int k = 0; k < __elem<A>::n; k++) v[i++] = E(a[k]);
  }
};
template <class V> __attribute__((always_inline)) inline V __vec() { return V{}; }
template <class V, class A> __attribute__((always_inline)) inline V __vec(A a) {
  if constexpr (__elem<A>::n == 1) { V r = (typename __elem<V>::type)a; return r; }
  else return __builtin_convertvector(a, V);
}
template <class V, class A, class B, class... R> __attribute__((always_inline)) inline V __vec(A a, B b, R... r) {
  __vbuild<V> v; v.put(a); v.put(b); (v.put(r), ...); return v.v;
}

enum class mem_flags { mem_none = 0, mem_device = 1, mem_threadgroup = 2, mem_texture = 4, mem_threadgroup_imageblock = 8, mem_object_data = 16 };
// Barriers: (memory flags, 5, execution scope: 1 threadgroup, 4 simdgroup).
extern "C" void __air_wg_barrier(int, int, int) __AIR("air.wg.barrier");
extern "C" void __air_simdgroup_barrier(int, int, int) __AIR("air.simdgroup.barrier");
__attribute__((always_inline)) inline void threadgroup_barrier(mem_flags f) { __air_wg_barrier(int(f), 5, 1); }
__attribute__((always_inline)) inline void simdgroup_barrier(mem_flags f) { __air_simdgroup_barrier(int(f), 5, 4); }

// ---- function constants (the driver rewrites is_function_constant_defined)
extern "C" bool __air_is_function_constant_defined(constant void *) __AIR("air.is_function_constant_defined");

// ---- atomics (observed: air.atomic.global.<op>.<u|s>.i32(ptr, value, order, scope 2, 0, volatile))
enum memory_order { memory_order_relaxed = 0 };
template <class T> struct _atomic { T __s; };
typedef _atomic<uint> atomic_uint;
typedef _atomic<int> atomic_int;
#define __MSL_ATOMIC(op) \
  extern "C" uint __air_atomic_global_##op##_u(device uint *, uint, int, int, int, bool) __AIR("air.atomic.global." #op ".u.i32"); \
  extern "C" int __air_atomic_global_##op##_s(device int *, int, int, int, int, bool) __AIR("air.atomic.global." #op ".s.i32"); \
  __attribute__((always_inline)) inline uint atomic_fetch_##op##_explicit(device atomic_uint *a, uint v, memory_order o) { return __air_atomic_global_##op##_u(&a->__s, v, int(o), 2, 0, false); } \
  __attribute__((always_inline)) inline int atomic_fetch_##op##_explicit(device atomic_int *a, int v, memory_order o) { return __air_atomic_global_##op##_s(&a->__s, v, int(o), 2, 0, false); }
__MSL_ATOMIC(add) __MSL_ATOMIC(sub) __MSL_ATOMIC(min) __MSL_ATOMIC(max) __MSL_ATOMIC(and) __MSL_ATOMIC(or) __MSL_ATOMIC(xor)

// ---- math. Observed names; fast_ variants under -ffast-math (rules_apple's default).
#ifdef __FAST_MATH__
#define __MSL_F(n) "air.fast_" #n
#else
#define __MSL_F(n) "air." #n
#endif
#define __MSL_MATH1(n, NAME) \
  extern "C" float __air_##n##_f32(float) __AIR(NAME ".f32"); \
  extern "C" float2 __air_##n##_v2f32(float2) __AIR(NAME ".v2f32"); \
  extern "C" float3 __air_##n##_v3f32(float3) __AIR(NAME ".v3f32"); \
  extern "C" float4 __air_##n##_v4f32(float4) __AIR(NAME ".v4f32"); \
  __attribute__((always_inline)) inline float n(float x) { return __air_##n##_f32(x); } \
  __attribute__((always_inline)) inline float2 n(float2 x) { return __air_##n##_v2f32(x); } \
  __attribute__((always_inline)) inline float3 n(float3 x) { return __air_##n##_v3f32(x); } \
  __attribute__((always_inline)) inline float4 n(float4 x) { return __air_##n##_v4f32(x); }
#define __MSL_MATH2(n, NAME) \
  extern "C" float __air_##n##_f32(float, float) __AIR(NAME ".f32"); \
  extern "C" float2 __air_##n##_v2f32(float2, float2) __AIR(NAME ".v2f32"); \
  extern "C" float3 __air_##n##_v3f32(float3, float3) __AIR(NAME ".v3f32"); \
  extern "C" float4 __air_##n##_v4f32(float4, float4) __AIR(NAME ".v4f32"); \
  __attribute__((always_inline)) inline float n(float x, float y) { return __air_##n##_f32(x, y); } \
  __attribute__((always_inline)) inline float2 n(float2 x, float2 y) { return __air_##n##_v2f32(x, y); } \
  __attribute__((always_inline)) inline float3 n(float3 x, float3 y) { return __air_##n##_v3f32(x, y); } \
  __attribute__((always_inline)) inline float4 n(float4 x, float4 y) { return __air_##n##_v4f32(x, y); } \
  __attribute__((always_inline)) inline float2 n(float2 x, float y) { return __air_##n##_v2f32(x, y); } \
  __attribute__((always_inline)) inline float3 n(float3 x, float y) { return __air_##n##_v3f32(x, y); } \
  __attribute__((always_inline)) inline float4 n(float4 x, float y) { return __air_##n##_v4f32(x, y); }
#define __MSL_MATH3(n, NAME) \
  extern "C" float __air_##n##_f32(float, float, float) __AIR(NAME ".f32"); \
  extern "C" float2 __air_##n##_v2f32(float2, float2, float2) __AIR(NAME ".v2f32"); \
  extern "C" float3 __air_##n##_v3f32(float3, float3, float3) __AIR(NAME ".v3f32"); \
  extern "C" float4 __air_##n##_v4f32(float4, float4, float4) __AIR(NAME ".v4f32"); \
  __attribute__((always_inline)) inline float n(float x, float y, float z) { return __air_##n##_f32(x, y, z); } \
  __attribute__((always_inline)) inline float2 n(float2 x, float2 y, float2 z) { return __air_##n##_v2f32(x, y, z); } \
  __attribute__((always_inline)) inline float3 n(float3 x, float3 y, float3 z) { return __air_##n##_v3f32(x, y, z); } \
  __attribute__((always_inline)) inline float4 n(float4 x, float4 y, float4 z) { return __air_##n##_v4f32(x, y, z); } \
  __attribute__((always_inline)) inline float2 n(float2 x, float2 y, float z) { return __air_##n##_v2f32(x, y, z); } \
  __attribute__((always_inline)) inline float3 n(float3 x, float3 y, float z) { return __air_##n##_v3f32(x, y, z); } \
  __attribute__((always_inline)) inline float4 n(float4 x, float4 y, float z) { return __air_##n##_v4f32(x, y, z); } \
  __attribute__((always_inline)) inline float2 n(float2 x, float y, float z) { return __air_##n##_v2f32(x, y, z); } \
  __attribute__((always_inline)) inline float3 n(float3 x, float y, float z) { return __air_##n##_v3f32(x, y, z); } \
  __attribute__((always_inline)) inline float4 n(float4 x, float y, float z) { return __air_##n##_v4f32(x, y, z); }
__MSL_MATH1(sin, __MSL_F(sin)) __MSL_MATH1(cos, __MSL_F(cos)) __MSL_MATH1(sqrt, __MSL_F(sqrt))
__MSL_MATH1(rsqrt, __MSL_F(rsqrt)) __MSL_MATH1(fabs, __MSL_F(fabs)) __MSL_MATH1(exp, __MSL_F(exp))
__MSL_MATH1(log, __MSL_F(log))
__MSL_MATH2(pow, __MSL_F(pow))
__MSL_MATH3(clamp, __MSL_F(clamp)) __MSL_MATH3(fma, "air.fma") __MSL_MATH3(mix, "air.mix")
#define __MSL_DOT(N) extern "C" float __air_dot_v##N##f32(float##N, float##N) __AIR("air.dot.v" #N "f32"); \
  __attribute__((always_inline)) inline float dot(float##N a, float##N b) { return __air_dot_v##N##f32(a, b); } \
  __attribute__((always_inline)) inline float##N normalize(float##N v) { return v * rsqrt(dot(v, v)); } \
  __attribute__((always_inline)) inline float length(float##N v) { return sqrt(dot(v, v)); }
__MSL_DOT(2) __MSL_DOT(3) __MSL_DOT(4)
__attribute__((always_inline)) inline float abs(float x) { return fabs(x); }

// ---- matrices: column-major, columns[c] is a vector of R elements.
template <class T, int C, int R> struct matrix {
  __vector<T, R> columns[C];
  __attribute__((always_inline)) __vector<T, R> &operator[](int c) { return columns[c]; }
  __attribute__((always_inline)) const __vector<T, R> &operator[](int c) const { return columns[c]; }
};
template <class T, int C, int R> __attribute__((always_inline)) inline __vector<T, R> operator*(const matrix<T, C, R> &m, __vector<T, C> v) {
  __vector<T, R> r = m.columns[0] * v[0];
  for (int c = 1; c < C; c++) r += m.columns[c] * v[c];
  return r;
}
template <class T, int C, int R> __attribute__((always_inline)) inline __vector<T, R> operator*(constant const matrix<T, C, R> &m, __vector<T, C> v) {
  __vector<T, R> r = m.columns[0] * v[0];
  for (int c = 1; c < C; c++) r += m.columns[c] * v[c];
  return r;
}
#define __MSL_MAT(T) typedef matrix<T, 2, 2> T##2x2; typedef matrix<T, 2, 3> T##2x3; typedef matrix<T, 2, 4> T##2x4; \
  typedef matrix<T, 3, 2> T##3x2; typedef matrix<T, 3, 3> T##3x3; typedef matrix<T, 3, 4> T##3x4; \
  typedef matrix<T, 4, 2> T##4x2; typedef matrix<T, 4, 3> T##4x3; typedef matrix<T, 4, 4> T##4x4;
__MSL_MAT(float) __MSL_MAT(half)
