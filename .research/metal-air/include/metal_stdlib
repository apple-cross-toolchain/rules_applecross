// Vector constructors: T4(a, b, ...) takes scalars and vectors in order;
// T4(s) splats a scalar; T4(v) converts a vector of the same width.
template <class V, class E = typename __elem<V>::type, int N = __elem<V>::n>
struct __vbuild {
  V v; int i = 0;
  template <class A> __attribute__((always_inline)) void put(A a) {
    if constexpr (__elem<A>::n == 1) v[i++] = E(a);
    else for (int k = 0; k < __elem<A>::n; k++) v[i++] = E(a[k]);
  }
};
template <class T, int N> struct __packed;
template <class T, int N> struct __elem<__packed<T, N>> { typedef T type; static constexpr int n = N; };
template <class V> __attribute__((always_inline)) inline V __vec() { return V{}; }
template <class V, class A> __attribute__((always_inline)) inline V __vec(A a) {
  if constexpr (__elem<A>::n == 1) { V r = (typename __elem<V>::type)a; return r; }
  else { V r; for (int k = 0; k < __elem<V>::n; k++) r[k] = (typename __elem<V>::type)a[k]; return r; }
}
template <class V, class A, class B, class... R> __attribute__((always_inline)) inline V __vec(A a, B b, R... r) {
  __vbuild<V> v; v.put(a); v.put(b); (v.put(r), ...); return v.v;
}

