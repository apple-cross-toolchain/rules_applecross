// ---- matrices: column-major, columns[c] is a vector of R elements.
template <bool B> struct __enable_cols {};
template <> struct __enable_cols<true> { typedef void type; };
// One member per column, so { {..}, {..}, {..} } initialises columns as MSL does.
template <class T, int C, int R> struct matrix;
#define __MSL_MATRIX_OPS(C) \
  __attribute__((always_inline)) __vector<T, R> &operator[](int c) { return (&__c0)[c]; } \
  __attribute__((always_inline)) const __vector<T, R> &operator[](int c) const { return (&__c0)[c]; }
template <class T, int R> struct matrix<T, 2, R> { __vector<T, R> __c0, __c1; __MSL_MATRIX_OPS(2) };
template <class T, int R> struct matrix<T, 3, R> { __vector<T, R> __c0, __c1, __c2; __MSL_MATRIX_OPS(3) };
template <class T, int R> struct matrix<T, 4, R> { __vector<T, R> __c0, __c1, __c2, __c3; __MSL_MATRIX_OPS(4) };
template <class T, int C, int R> __attribute__((always_inline)) inline __vector<T, R> operator*(const matrix<T, C, R> &m, __vector<T, C> v) {
  __vector<T, R> r = m[0] * v[0];
  for (int c = 1; c < C; c++) r += m[c] * v[c];
  return r;
}
template <class T, int C, int R> __attribute__((always_inline)) inline __vector<T, C> operator*(__vector<T, R> v, const matrix<T, C, R> &m) {
  __vector<T, C> r;
  for (int c = 0; c < C; c++) { __vector<T, R> p = v * m[c]; T s = p[0]; for (int k = 1; k < R; k++) s += p[k]; r[c] = s; }
  return r;
}
template <class T, int K, int C, int R> __attribute__((always_inline)) inline matrix<T, C, R> operator*(const matrix<T, K, R> &a, const matrix<T, C, K> &b) {
  matrix<T, C, R> m;
  for (int c = 0; c < C; c++) m[c] = a * b[c];
  return m;
}
// T CxR(...) constructors, rewritten by the driver to __mat: C columns, one
// scalar for the diagonal, or C*R scalars in column order.
template <class X, class... R> __attribute__((always_inline)) inline X __first(X x, R...) { return x; }
template <class M> struct __mat_traits;
template <class T, int C, int R> struct __mat_traits<matrix<T, C, R>> { typedef T E; static constexpr int c = C, r = R; };
template <class M, class... A> __attribute__((always_inline)) inline M __mat(A... a) {
  typedef __mat_traits<M> tr;
  M m;
  if constexpr (sizeof...(A) == tr::c) {
    int i = 0; ((m[i++] = a), ...);
  } else if constexpr (sizeof...(A) == 1) {
    typename tr::E d = (typename tr::E)__first(a...);
    for (int c = 0; c < tr::c; c++) { m[c] = (typename tr::E)0; if (c < tr::r) m[c][c] = d; }
  } else {
    typename tr::E v[] = {(typename tr::E)a...};
    for (int c = 0; c < tr::c; c++) for (int r = 0; r < tr::r; r++) m[c][r] = v[c * tr::r + r];
  }
  return m;
}
