// Vector constructors: T4(a, b, ...) takes scalars and vectors in order;
// T4(s) splats a scalar; T4(v) converts a vector of the same width.
template <class V, class E = typename __elem<V>::type, int N = __elem<V>::n>
struct __vbuild {
  V v; int i = 0;
  template <class A> __attribute__((always_inline)) void put(A a) {
    if constexpr (__elem<A>::n == 1) v[i++] = E(a);
    else for (int k = 0; k < __elem<A>::n; k++) v[i++] = E(a[k]);
  }
};
template <class T, int N> struct __packed;
template <class T, int N> struct __elem<__packed<T, N>> { typedef T type; static constexpr int n = N; };
template <bool B, class T = void> struct enable_if {};
template <class T> struct enable_if<true, T> { typedef T type; };
template <int... I> struct __seq {};
template <int N, int... I> struct __mkseq : __mkseq<N - 1, N - 1, I...> {};
template <int... I> struct __mkseq<0, I...> { typedef __seq<I...> type; };
template <class V> constexpr V __vec() { return V{}; }
// Scalars only: brace construction, which clang can constant-evaluate (program-scope constants).
template <class V, int... I, class S> constexpr V __splat(__seq<I...>, S s) { return V{((void)I, (typename __elem<V>::type)s)...}; }
template <class V, class A> constexpr V __vec(A a) {
  if constexpr (__elem<A>::n == 1) return __splat<V>(typename __mkseq<__elem<V>::n>::type(), a);
  else { V r; for (int k = 0; k < __elem<V>::n; k++) r[k] = (typename __elem<V>::type)a[k]; return r; }
}
template <class V, class A, class B, class... R> constexpr V __vec(A a, B b, R... r) {
  if constexpr (__elem<A>::n == 1 && __elem<B>::n == 1 && (... && (__elem<R>::n == 1)) && 2 + sizeof...(R) == __elem<V>::n) {
    typedef typename __elem<V>::type E; return V{(E)a, (E)b, (E)r...};
  } else {
    __vbuild<V> v; v.put(a); v.put(b); (v.put(r), ...); return v.v;
  }
}

