// ---- bool vectors: fields x..w, built from a bool (splat) or a comparison
// mask (nonzero is true); converting to a number gives 0 or 1, as in MSL.
template <int N> struct __boolvec;
#define __MSL_BOOLVEC_OPS(N) \
  __boolvec() = default; \
  __attribute__((always_inline)) __boolvec(bool b) { for (int k = 0; k < N; k++) (*this)[k] = b; } \
  template <class V, class = typename enable_if<__elem<V>::n == N>::type> \
  __attribute__((always_inline)) __boolvec(V m) { for (int k = 0; k < N; k++) (*this)[k] = m[k] != 0; } \
  __attribute__((always_inline)) bool &operator[](int k) { return (&x)[k]; } \
  __attribute__((always_inline)) bool operator[](int k) const { return (&x)[k]; }
template <> struct __boolvec<2> { bool x, y; __MSL_BOOLVEC_OPS(2) };
template <> struct __boolvec<3> { bool x, y, z; __MSL_BOOLVEC_OPS(3) };
template <> struct __boolvec<4> { bool x, y, z, w; __MSL_BOOLVEC_OPS(4) };
template <int N> struct __elem<__boolvec<N>> { typedef bool type; static constexpr int n = N; };
template <int N> __attribute__((always_inline)) inline bool any(__boolvec<N> b) { bool r = false; for (int k = 0; k < N; k++) r = r || b[k]; return r; }
template <int N> __attribute__((always_inline)) inline bool all(__boolvec<N> b) { bool r = true; for (int k = 0; k < N; k++) r = r && b[k]; return r; }
template <class V, int N> __attribute__((always_inline)) inline V select(V a, V b, __boolvec<N> c) { V r = a; for (int k = 0; k < N; k++) if (c[k]) r[k] = b[k]; return r; }
template <class V> __attribute__((always_inline)) inline V select(V a, V b, bool c) { return c ? b : a; }

