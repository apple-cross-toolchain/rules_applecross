// Our own Metal Shading Language subset for clang 15, written from the MSL
// specification and from the AIR Xcode emits for our probe shaders.
#pragma once
// The driver reads [[attributes]] (rewritten to __MSL_ATTR) and stage keywords
// from an AST pass with __MSL_AST defined; codegen sees neither.
#ifdef __MSL_AST
#define __MSL_ATTR(x) __attribute__((annotate(x)))
#else
#define __MSL_ATTR(x)
#endif
#define kernel static __MSL_ATTR("msl.stage:kernel") __attribute__((always_inline))
#define vertex static __MSL_ATTR("msl.stage:vertex") __attribute__((always_inline))
#define fragment static __MSL_ATTR("msl.stage:fragment") __attribute__((always_inline))
// Address spaces: the AST pass sees them (for the metadata); codegen compiles
// flat and the driver infers them back from the entry points (MSL's member
// functions and operators then work on objects in any address space).
#define __MSL_DEVICE __attribute__((address_space(1)))
#define __MSL_CONSTANT __attribute__((address_space(2)))
#define __MSL_THREADGROUP __attribute__((address_space(3)))
#ifdef __MSL_AST
#define device __attribute__((address_space(1)))
#define constant __attribute__((address_space(2)))
#define threadgroup __attribute__((address_space(3)))
#else
#define device
#define constant
#define threadgroup
#endif
#define thread
#define __AIR(name) __asm__(name)

