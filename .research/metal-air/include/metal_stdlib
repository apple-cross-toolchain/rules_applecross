template <class T, int N> using __vector = T __attribute__((ext_vector_type(N)));
template <class T> struct __elem { typedef T type; static constexpr int n = 1; };
#define __MSL_ELEM(T) \
  template <> struct __elem<T##2> { typedef T type; static constexpr int n = 2; }; \
  template <> struct __elem<T##3> { typedef T type; static constexpr int n = 3; }; \
  template <> struct __elem<T##4> { typedef T type; static constexpr int n = 4; };
