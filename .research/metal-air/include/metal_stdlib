// ---- textures and samplers: opaque handles, as in AIR.
struct _texture_2d_t; struct _sampler_t;
namespace metal {
enum class access { sample = 0, read = 1, write = 2, read_write = 3 };
struct sampler { constant _sampler_t *__s; };
struct __ret_v4f32 { float4 v; char status; };
extern "C" uint __air_get_width_texture_2d(device _texture_2d_t *, int) __AIR("air.get_width_texture_2d");
extern "C" uint __air_get_height_texture_2d(device _texture_2d_t *, int) __AIR("air.get_height_texture_2d");
extern "C" constant _sampler_t *__air_get_read_sampler() __AIR("air.get_read_sampler");
extern "C" __ret_v4f32 __air_read_texture_2d_v4f32(device _texture_2d_t *, constant _sampler_t *, uint2, uint2, int, int) __AIR("air.read_texture_2d.v4f32");
extern "C" void __air_write_texture_2d_v4f32(device _texture_2d_t *, uint2, float4, int, int) __AIR("air.write_texture_2d.v4f32");
template <class T, access A = access::sample> struct texture2d {
  device _texture_2d_t *__t;
  __attribute__((always_inline)) uint get_width(uint lod = 0) const { return __air_get_width_texture_2d(__t, lod); }
  __attribute__((always_inline)) uint get_height(uint lod = 0) const { return __air_get_height_texture_2d(__t, lod); }
  __attribute__((always_inline)) float4 read(uint2 c, uint lod = 0) const { return __air_read_texture_2d_v4f32(__t, __air_get_read_sampler(), c, uint2{0u, 0u}, lod, int(A)).v; }
  __attribute__((always_inline)) void write(float4 v, uint2 c, uint lod = 0) const { __air_write_texture_2d_v4f32(__t, c, v, lod, int(A)); }
};
}  // namespace metal
