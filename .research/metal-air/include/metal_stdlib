// smoothstep (MSL specification): edges may be scalars for vector x
template <class V, class E0, class E1> __attribute__((always_inline)) inline V smoothstep(E0 e0, E1 e1, V x) {
  typedef typename __elem<V>::type E;
  V a, b;
  if constexpr (__elem<E0>::n == 1) a = (E)e0; else a = e0;
  if constexpr (__elem<E1>::n == 1) b = (E)e1; else b = e1;
  V t = clamp((x - a) / (b - a), (E)0, (E)1);
  return t * t * ((E)3 - (E)2 * t);
}
