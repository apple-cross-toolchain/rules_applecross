load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

rust_binary(
    name = "codesign",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//visibility:public"],
    deps = [
        "//crates/cf",
        "//crates/macho",
        "@crates//:regex",
        "@crates//:rsa",
        "@crates//:sha1",
        "@crates//:sha2",
        "@crates//:x509-cert",
    ],
)

rust_test(
    name = "test",
    # Apple's codesign output the identity signature is checked against.
    compile_data = glob(["tests/data/**"]),
    crate = ":codesign",
)
