load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

cc_library(
    name = "lzfse_c",
    srcs = glob(["vendor/*.c"]),
    hdrs = glob(["vendor/*.h"]),
    copts = [
        "-O2",
        "-w",
    ],
)

rust_library(
    name = "lzfse",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//visibility:public"],
    deps = [":lzfse_c"],
)

rust_test(
    name = "test",
    crate = ":lzfse",
)
