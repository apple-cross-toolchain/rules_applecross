template <class T, int C, int R> __attribute__((always_inline)) inline matrix<T, C, R> operator-(const matrix<T, C, R> &a, const matrix<T, C, R> &b) { return __subtract(a, b, (typename __mkseq<C>::type *)0); }
// row J of a C-column matrix, as a column of its transpose
template <int J, class T, int C, int R, int... I> __attribute__((always_inline)) inline __vector<T, C> __row(const matrix<T, C, R> &m, __seq<I...> *) { return __vector<T, C>{m[I][J]...}; }
template <class T, int C, int R, int... J> __attribute__((always_inline)) inline matrix<T, R, C> __transpose(const matrix<T, C, R> &m, __seq<J...> *) {
  __vector<T, C> c[R] = {__row<J>(m, (typename __mkseq<C>::type *)0)...};
  return matrix<T, R, C>(__column_list<__vector<T, C>>{c, R}, (__seq<J...> *)0);
