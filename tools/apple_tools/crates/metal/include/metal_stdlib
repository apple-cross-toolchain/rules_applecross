}
template <class T, int C, int R> __attribute__((always_inline)) inline matrix<T, C, R> operator*(const matrix<T, C, R> &a, typename __nondeduced<T>::type s) { return __scale(a, s, (typename __mkseq<C>::type *)0); }
template <class T, int C, int R> __attribute__((always_inline)) inline matrix<T, C, R> operator*(typename __nondeduced<T>::type s, const matrix<T, C, R> &a) { return __scale(a, s, (typename __mkseq<C>::type *)0); }
template <class T, int C, int R> __attribute__((always_inline)) inline matrix<T, C, R> operator/(const matrix<T, C, R> &a, typename __nondeduced<T>::type s) { return __divide(a, s, (typename __mkseq<C>::type *)0); }
template <class T, int C, int R, int... I> __attribute__((always_inline)) inline matrix<T, C, R> __add(const matrix<T, C, R> &a, const matrix<T, C, R> &b, __seq<I...> *) {
