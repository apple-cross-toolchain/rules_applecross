// determinants by cofactors along the first column
template <class T> __attribute__((always_inline)) inline T __det2(T a, T b, T c, T d) { return a * d - c * b; }
template <class T> __attribute__((always_inline)) inline T __det3(T a0, T a1, T a2, T b0, T b1, T b2, T c0, T c1, T c2) {
  return a0 * __det2(b1, b2, c1, c2) - a1 * __det2(b0, b2, c0, c2) + a2 * __det2(b0, b1, c0, c1);
}
template <class T> __attribute__((always_inline)) inline T determinant(const matrix<T, 2, 2> &m) { return __det2(m[0][0], m[0][1], m[1][0], m[1][1]); }
template <class T> __attribute__((always_inline)) inline T determinant(const matrix<T, 3, 3> &m) { return __det3(m[0][0], m[0][1], m[0][2], m[1][0], m[1][1], m[1][2], m[2][0], m[2][1], m[2][2]); }
template <class T> __attribute__((always_inline)) inline T determinant(const matrix<T, 4, 4> &m) {
  const __vector<T, 4> a = m[0], b = m[1], c = m[2], d = m[3];
  return a[0] * __det3(b[1], b[2], b[3], c[1], c[2], c[3], d[1], d[2], d[3]) - a[1] * __det3(b[0], b[2], b[3], c[0], c[2], c[3], d[0], d[2], d[3])
       + a[2] * __det3(b[0], b[1], b[3], c[0], c[1], c[3], d[0], d[1], d[3]) - a[3] * __det3(b[0], b[1], b[2], c[0], c[1], c[2], d[0], d[1], d[2]);
}
// T CxR(...) constructors, rewritten by the driver to __mat: C columns, one
// scalar for the diagonal, or C*R scalars in column order.
template <class X, class... R> __attribute__((always_inline)) inline X __first(X x, R...) { return x; }
template <class M> struct __mat_traits;
template <class T, int C, int R> struct __mat_traits<matrix<T, C, R>> { typedef T E; static constexpr int c = C, r = R; };
template <class C, int... J, class E> constexpr C __col(const E *v, int base, __seq<J...> *) { return C{v[base + J]...}; }
template <class M, int... I, class... A> constexpr M __mat_scalars(__seq<I...> *, A... a) {
  typedef __mat_traits<M> tr; typedef typename tr::E E; typedef __vector<E, tr::r> C;
  E v[] = {(E)a...};
  return M{__col<C>(v, I * tr::r, (typename __mkseq<tr::r>::type *)0)...};
}
template <int I, class M, class E> constexpr void __mat_diagonal_column(M &m, E d) { m[I] = (E)0; if constexpr (I < __mat_traits<M>::r) m[I][I] = d; }
template <class M, class E, int... I> constexpr void __mat_diagonal(M &m, E d, __seq<I...> *) { (__mat_diagonal_column<I>(m, d), ...); }
template <class M, class S, int... I> constexpr void __mat_convert(M &m, const S &s, __seq<I...> *) {
  typedef __mat_traits<M> tr; ((m[I] = __convert_each<__vector<typename tr::E, tr::r>>(s[I], (typename __mkseq<tr::r>::type *)0)), ...);
}
template <class M, class... A> constexpr M __mat(A... a) {
  typedef __mat_traits<M> tr; typedef __vector<typename tr::E, tr::r> C;
  if constexpr (sizeof...(A) == tr::c && (... && (__elem<A>::n == tr::r))) {
    return M{C(a)...};
  } else if constexpr (sizeof...(A) == 1 && (... && (__elem<A>::n == 1))) {
    M m{}; typename tr::E d = (typename tr::E)__first(a...);
    __mat_diagonal(m, d, (typename __mkseq<tr::c>::type *)0);
    return m;
  } else if constexpr (sizeof...(A) == 1) {
    M m{}; auto s = __first(a...);   // another matrix: convert column by column
    __mat_convert(m, s, (typename __mkseq<tr::c>::type *)0);
    return m;
  } else {
    return __mat_scalars<M>((typename __mkseq<tr::c>::type *)0, a...);
  }
}
