// Vector constructors: T4(a, b, ...) takes scalars and vectors in order;
// T4(s) splats a scalar; T4(v) converts a vector of the same width.
// Fixed-count loops are written as pack expansions over __seq: straight-line
// code, as Xcode's builtins give it, before LLVM's first attribute inference.
template <int... I> struct __seq {};
template <int N, int... I> struct __mkseq : __mkseq<N - 1, N - 1, I...> {};
template <int... I> struct __mkseq<0, I...> { typedef __seq<I...> type; };
template <bool B, class T = void> struct enable_if {};
template <class T> struct enable_if<true, T> { typedef T type; };
template <class T, int N> struct __packed;
template <class T, int N> struct __elem<__packed<T, N>> { typedef T type; static constexpr int n = N; };
template <class V, class A, int... K> __attribute__((always_inline)) constexpr V __convert_each(A a, __seq<K...> *) { V r; ((r[K] = (typename __elem<V>::type)a[K]), ...); return r; }
template <class V> __attribute__((always_inline)) constexpr V __vec() { return V{}; }
// Scalars only: brace construction, which clang can constant-evaluate (program-scope constants).
template <class V, int... I, class S> constexpr V __splat(__seq<I...> *, S s) { return V{((void)I, (typename __elem<V>::type)s)...}; }
// As Xcode builds vectors: a scalar splats (insert and shuffle), a vector of the
// same width converts as a whole, and a leading vector widens by a shuffle
// before the rest is inserted.
// A scalar converts at the call (in the user's code, as Xcode converts it), then splats.
template <class V> __attribute__((always_inline)) constexpr V __vec(typename __elem<V>::type e) { return (V)e; }
template <class V, class A, class = typename enable_if<(__elem<A>::n > 1)>::type> __attribute__((always_inline)) constexpr V __vec(A a) {
  typedef typename __elem<V>::type E;
  if constexpr (__is_same(A, V)) return a;
  else if constexpr (__is_same(A, __vector<typename __elem<A>::type, __elem<A>::n>)) return __builtin_convertvector(a, V);
  else if constexpr (__is_same(typename __elem<A>::type, bool)) return (V)a;   // a bool vector converts as a whole
  else return __convert_each<V>(a, (typename __mkseq<__elem<V>::n>::type *)0);
}
template <class V, class A, int... I, int... U> __attribute__((always_inline)) V __widen(A a, __seq<I...> *, __seq<U...> *) {
  return __builtin_shufflevector(a, a, I..., ((void)U, -1)...);
}
// A vector built in a function (the driver writes T4(a, b, ...) as a statement expression of
// puts, each argument as it comes): each put returns the vector so far, its position in its type.
// A scalar goes in by insertelement (converted at the call, in the user's code, as Xcode converts
// it); a vector of the element type widens and shuffles in, as Xcode's frontend builds it.
template <class V, int I, int n, int... K> __attribute__((always_inline)) V __place(V v, V w, __seq<K...> *) {
  return __builtin_shufflevector(v, w, (K < I ? K : K < I + n ? __elem<V>::n + K - I : -1)...);
}
template <class V, int I, class E = typename __elem<V>::type, int N = __elem<V>::n>
struct __vpart {
  V v;
  __attribute__((always_inline)) __vpart<V, I + 1> put(E e) const { __vpart<V, I + 1> r; r.v = v; r.v[I] = e; return r; }
  template <class A, int... K> __attribute__((always_inline)) void put_each(A a, __seq<K...> *) { ((v[I - __elem<A>::n + K] = E(a[K])), ...); }
  template <class A, class = typename enable_if<(__elem<A>::n > 1)>::type> __attribute__((always_inline)) __vpart<V, I + __elem<A>::n> put(A a) const {
    constexpr int n = __elem<A>::n;
    __vpart<V, I + n> r;
    if constexpr (n < N && __is_same(A, __vector<E, n>)) {
      V w = __widen<V>(a, (typename __mkseq<n>::type *)0, (typename __mkseq<N - n>::type *)0);
      if constexpr (I == 0) r.v = w;
      else r.v = __place<V, I, n>(v, w, (typename __mkseq<N>::type *)0);
    } else {
      r.v = v;
      r.put_each(a, (typename __mkseq<n>::type *)0);
    }
    return r;
  }
};
// A packed vector converts element by element where it is (no copy), as Xcode's frontend reads one
template <class V, class T, int N, int... K> __attribute__((always_inline)) constexpr V __unpack(const __packed<T, N> &a, __seq<K...> *) { V r; ((r[K] = (typename __elem<V>::type)a.__e[K]), ...); return r; }
template <class V, class T, int N> __attribute__((always_inline)) constexpr V __vec(const __packed<T, N> &a) { return __unpack<V>(a, (typename __mkseq<N>::type *)0); }
template <class P> __attribute__((always_inline)) auto __vchain(P p) { return p.v; }
template <class P, class A, class... R> __attribute__((always_inline)) auto __vchain(P p, A a, R... r) { return __vchain(p.put(a), r...); }
template <class V, class A, class B, class... R> __attribute__((always_inline)) constexpr V __vec(A a, B b, R... r) {
  if constexpr (__elem<A>::n == 1 && __elem<B>::n == 1 && (... && (__elem<R>::n == 1)) && 2 + sizeof...(R) == __elem<V>::n) {
    typedef typename __elem<V>::type E; return V{(E)a, (E)b, (E)r...};
  } else {
    __vpart<V, 0> v; return __vchain(v, a, b, r...);
  }
}

