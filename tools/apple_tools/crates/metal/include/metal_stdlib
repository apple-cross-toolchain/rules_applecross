// bfloat: clang 15 has no __bf16 on this target, so 16 bits with IEEE
// conversions (round to nearest even from float, NaN kept quiet).
struct bfloat {
  ushort __b;
  bfloat() = default;
  __attribute__((always_inline)) bfloat(float f) {
    uint u = __builtin_bit_cast(uint, f);
    __b = (u & 0x7fffffffu) > 0x7f800000u ? (ushort)((u >> 16) | 0x40u) : (ushort)((u + 0x7fffu + ((u >> 16) & 1u)) >> 16);
  }
  __attribute__((always_inline)) operator float() const { return __builtin_bit_cast(float, (uint)__b << 16); }
};

// as_type: reinterpret the bits (same size)
template <class T, class U> __attribute__((always_inline)) inline T as_type(U u) { return __builtin_bit_cast(T, u); }

