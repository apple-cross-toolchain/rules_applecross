// M * v as Xcode's header builds it: from a zero vector, one level per column
// adding that column's product before going on to the next
template <class T, int C, int R, int I0, int... I> __attribute__((always_inline)) inline __vector<T, R> __mul(__vector<T, R> acc, const matrix<T, C, R> &m, __vector<T, C> v, __seq<I0, I...> *) {
  constexpr int k = C - 1 - int(sizeof...(I));
  if constexpr (sizeof...(I) == 0) return acc + m[k] * v[k];
  else return __mul(acc + m[k] * v[k], m, v, (typename __mkseq<int(sizeof...(I))>::type *)0);
}
template <class T, int C, int R> __attribute__((always_inline)) inline __vector<T, R> operator*(const matrix<T, C, R> &m, __vector<T, C> v) { return __mul(__vector<T, R>(0), m, v, (typename __mkseq<C>::type *)0); }
template <class T, int C, int R, int... I> __attribute__((always_inline)) inline __vector<T, C> __mul(__vector<T, R> v, const matrix<T, C, R> &m, __seq<I...> *) {
  __vector<T, C> r;
  // each column's dot product (air.dot), as Xcode computes v * M
  ((r[I] = dot(v, m[I])), ...);
  return r;
}
template <class T, int C, int R> __attribute__((always_inline)) inline __vector<T, C> operator*(__vector<T, R> v, const matrix<T, C, R> &m) { return __mul(v, m, (typename __mkseq<C>::type *)0); }
// A * B as Xcode's IR before its attribute inference shows it built: the columns into a
// list, read back through the list's pointer by a constructor the inliner takes in its
// walk, so that the inference (run before the walk's simplification) counts a product
// as reading memory: A * B is readonly where A * v is readnone
template <class T, int K, int C, int R, int... I> __attribute__((always_inline)) inline matrix<T, C, R> __mul(const matrix<T, K, R> &a, const matrix<T, C, K> &b, __seq<I...> *) {
  __vector<T, R> c[C] = {a * b[I]...};
  return matrix<T, C, R>(__column_list<__vector<T, R>>{c, C}, (__seq<I...> *)0);
}
template <class T, int K, int C, int R> __attribute__((always_inline)) inline matrix<T, C, R> operator*(const matrix<T, K, R> &a, const matrix<T, C, K> &b) { return __mul(a, b, (typename __mkseq<C>::type *)0); }
template <class T> struct __nondeduced { typedef T type; };
// m * s, s * m, m / s and transpose are built through a column list as A * B is (Xcode's
// are readonly); m + n and m - n column by column (readnone)
template <class T, int C, int R, int... I> __attribute__((always_inline)) inline matrix<T, C, R> __scale(const matrix<T, C, R> &a, T s, __seq<I...> *) {
  __vector<T, R> c[C] = {s * a[I]...};
  return matrix<T, C, R>(__column_list<__vector<T, R>>{c, C}, (__seq<I...> *)0);
}
template <class T, int C, int R, int... I> __attribute__((always_inline)) inline matrix<T, C, R> __divide(const matrix<T, C, R> &a, T s, __seq<I...> *) {
  __vector<T, R> c[C] = {a[I] / s...};
