// ---- bool vectors: fields x..w, built from a bool (splat) or a comparison
// mask (nonzero is true); converting to a number gives 0 or 1, as in MSL.
template <int N> struct __boolvec;
#define __MSL_BOOLVEC_OPS(N) \
  __boolvec() = default; \
  template <int... K> __attribute__((always_inline)) void fill(bool b, __seq<K...> *) { (((*this)[K] = b), ...); } \
  template <class V, int... K> __attribute__((always_inline)) void mask(V m, __seq<K...> *) { (((*this)[K] = m[K] != 0), ...); } \
  template <class B, int... K> __attribute__((always_inline)) void from_bits(B b, __seq<K...> *) { (((*this)[K] = b[K]), ...); } \
  template <int... K> __attribute__((always_inline)) __vector<bool, N> bits(__seq<K...> *) const { return __vector<bool, N>{(*this)[K]...}; } \
  __attribute__((always_inline)) explicit __boolvec(__vector<bool, N> b) { from_bits(b, (typename __mkseq<N>::type *)0); } \
  __attribute__((always_inline)) __boolvec(bool b) { fill(b, (typename __mkseq<N>::type *)0); } \
  template <class V, class = typename enable_if<__elem<V>::n == N>::type> \
  __attribute__((always_inline)) __boolvec(V m) { mask(m, (typename __mkseq<N>::type *)0); } \
  template <class V, class = typename enable_if<__elem<V>::n == N>::type> \
  __attribute__((always_inline)) explicit operator V() const { return __builtin_convertvector(bits((typename __mkseq<N>::type *)0), V); } \
  __attribute__((always_inline)) bool &operator[](int k) { return (&x)[k]; } \
  __attribute__((always_inline)) bool operator[](int k) const { return (&x)[k]; }
template <> struct __boolvec<2> { bool x, y; __MSL_BOOLVEC_OPS(2) };
template <> struct __boolvec<3> { bool x, y, z; __MSL_BOOLVEC_OPS(3) };
template <> struct __boolvec<4> { bool x, y, z, w; __MSL_BOOLVEC_OPS(4) };
template <int N> struct __elem<__boolvec<N>> { typedef bool type; static constexpr int n = N; };
template <int N, int... K> __attribute__((always_inline)) inline bool __any(__boolvec<N> b, __seq<K...> *) { bool r = false; ((r = r || b[K]), ...); return r; }
template <int N, int... K> __attribute__((always_inline)) inline bool __all(__boolvec<N> b, __seq<K...> *) { bool r = true; ((r = r && b[K]), ...); return r; }
template <class V, int N, int... K> __attribute__((always_inline)) inline V __select(V a, V b, __boolvec<N> c, __seq<K...> *) { V r = a; ((c[K] ? (void)(r[K] = b[K]) : (void)0), ...); return r; }
template <int N> __attribute__((always_inline)) inline bool any(__boolvec<N> b) { return __any(b, (typename __mkseq<N>::type *)0); }
template <int N> __attribute__((always_inline)) inline bool all(__boolvec<N> b) { return __all(b, (typename __mkseq<N>::type *)0); }
template <class V, int N> __attribute__((always_inline)) inline V select(V a, V b, __boolvec<N> c) { return __select(a, b, c, (typename __mkseq<N>::type *)0); }
template <class V> __attribute__((always_inline)) inline V select(V a, V b, bool c) { return c ? b : a; }

