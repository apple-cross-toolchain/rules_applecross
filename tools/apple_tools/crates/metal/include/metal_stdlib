// refract (MSL specification)
#define __MSL_REFRACT(V, S) __attribute__((always_inline)) inline V refract(V i, V n, S eta) { \
  S k = (S)1 - eta * eta * ((S)1 - dot(n, i) * dot(n, i)); \
  return k < (S)0 ? (V)(S)0 : eta * i - (eta * dot(n, i) + sqrt(k)) * n; }
