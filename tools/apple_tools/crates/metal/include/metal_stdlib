// ---- matrices: column-major, columns[c] is a vector of R elements.
template <bool B> struct __enable_cols {};
template <> struct __enable_cols<true> { typedef void type; };
// The columns as one array (as Xcode lays a matrix out: { [C x <R x T>] }),
// constructed from C columns, so { {..}, {..}, {..} } initialises columns as MSL does.
template <class T, int C, int R> struct matrix;
template <class V> struct __column_list { const V *p; long n; };
// A column argument: a vector, or a braced list of elements converted as MSL does.
template <class T, int R> struct __column {
  __vector<T, R> v;
  constexpr __column(__vector<T, R> c) : v(c) {}
  template <class... X> constexpr __column(X... x) : v{(T)x...} {}
};
#define __MSL_MATRIX(C, PARAMS, ARGS) \
  template <class T, int R> struct matrix<T, C, R> { \
    __vector<T, R> columns[C]; \
    matrix() = default; \
    constexpr matrix(PARAMS) : columns{ARGS} {} \
    template <int... I> matrix(const __column_list<__vector<T, R>> &l, __seq<I...> *) { ((columns[I] = I < l.n ? l.p[I] : __vector<T, R>(0)), ...); } \
    __attribute__((always_inline)) __vector<T, R> &operator[](int c) { return columns[c]; } \
    __attribute__((always_inline)) const __vector<T, R> &operator[](int c) const { return columns[c]; } \
  };
