load("@rules_cc//cc:cc_binary.bzl", "cc_binary")

cc_binary(
    name = "unzip",
    srcs = glob([
        "*.h",
        "unix/*.h",
    ]) + [
        "crc32.c",
        "crypt.c",
        "envargs.c",
        "explode.c",
        "extract.c",
        "fileio.c",
        "globals.c",
        "inflate.c",
        "list.c",
        "match.c",
        "process.c",
        "ttyio.c",
        "ubz2err.c",
        "unix/unix.c",
        "unreduce.c",
        "unshrink.c",
        "unzip.c",
        "zipinfo.c",
    ],
    copts = [
        "-DACORN_FTYPE_NFS",
        "-DDATE_FORMAT=DF_YMD",
        "-DIZ_HAVE_UXUIDGID",
        "-DLARGE_FILE_SUPPORT",
        "-DNOMEMCPY",
        "-DNO_LCHMOD",
        "-DNO_WORKING_ISPRINT",
        "-DUNICODE_SUPPORT",
        "-DUNICODE_WCHAR",
        "-DUSE_BZIP2",
        "-DUTF8_MAYBE_NATIVE",
        "-DWILD_STOP_AT_DIR",
        "-std=gnu17",
        "-w",
    ],
    visibility = ["//visibility:public"],
    deps = ["@bzip2//:bz2"],
)
