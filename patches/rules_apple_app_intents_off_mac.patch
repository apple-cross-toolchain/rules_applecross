+# Off a Mac nothing sets SDKROOT: the SDK is the platform's under DEVELOPER_DIR.
+SDKROOT="${{SDKROOT:-$DEVELOPER_DIR/Platforms/$APPLE_SDK_PLATFORM.platform/Developer/SDKs/$APPLE_SDK_PLATFORM.sdk}}"
