Build for Apple silicon when nothing names a CPU, as on a Linux host: macOS
targets for arm64, and iOS, tvOS and watchOS simulator targets for their arm64
simulators. rules_apple chose x86_64 there (for macOS unless the minimum OS was
27.0), which an Apple silicon Mac without Rosetta refuses to open
(LaunchServices -10669) and its simulators refuse to install. A Mac host still
builds for its own CPU, an Intel one for x86_64, and the --*_cpus flags still win.

diff --git a/apple/internal/transition_support.bzl b/apple/internal/transition_support.bzl
--- a/apple/internal/transition_support.bzl
+++ b/apple/internal/transition_support.bzl
@@ -106,13 +106,11 @@
 }
 
 def _macos_default_arch(*, minimum_os_version):
-    # There is no Intel version of macOS 27, so default to arm64 when the minimum OS version is
-    # 27.0 or higher. Fall back to x86_64 for earlier minimum OS versions until we're ready to
-    # switch the default for all macOS builds to Apple Silicon (arm64).
-    if (minimum_os_version and
-        apple_common.dotted_version(minimum_os_version) >= apple_common.dotted_version("27.0")):
-        return "arm64"
-    return "x86_64"
+    # Reached only when nothing names a macOS CPU: no --macos_cpus, no macOS
+    # platform and no darwin --cpu, as on a Linux host. A Mac builds for its
+    # own CPU. Default to Apple silicon, which every macOS since 27 requires;
+    # an x86_64-only app needs Rosetta on the Macs people have.
+    return "arm64"
 
 def _platform_specific_cpu_setting_name(platform_type):
     """Returns the name of a platform-specific CPU setting.
@@ -317,9 +315,9 @@
         cpu_value = settings["//command_line_option:cpu"]
         if cpu_value.startswith("ios_"):
             return cpu_value
-        if cpu_value == "darwin_arm64":
-            return "ios_sim_arm64"
-        return "ios_x86_64"
+        if cpu_value == "darwin_x86_64":
+            return "ios_x86_64"
+        return "ios_sim_arm64"
     if platform_type == "visionos":
         if environment_arch:
             return "visionos_{}".format(environment_arch)
@@ -358,9 +356,9 @@
         cpu_value = settings["//command_line_option:cpu"]
         if cpu_value.startswith("tvos_"):
             return cpu_value
-        if cpu_value == "darwin_arm64":
-            return "tvos_sim_arm64"
-        return "tvos_x86_64"
+        if cpu_value == "darwin_x86_64":
+            return "tvos_x86_64"
+        return "tvos_sim_arm64"
     if platform_type == "watchos":
         if environment_arch:
             return "watchos_{}".format(environment_arch)
@@ -373,9 +371,9 @@
         cpu_value = settings["//command_line_option:cpu"]
         if cpu_value.startswith("watchos_"):
             return cpu_value
-        if cpu_value == "darwin_arm64":
-            return "watchos_arm64"
-        return "watchos_x86_64"
+        if cpu_value == "darwin_x86_64":
+            return "watchos_x86_64"
+        return "watchos_arm64"
 
     fail("ERROR: Unknown platform type: {}".format(platform_type))
 
